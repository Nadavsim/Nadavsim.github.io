---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const withContent = await Promise.all(all.map(async (p) => ({ p, Content: (await render(p)).Content })));
const groups = [
  { id: 'personal', title: 'Personal projects', items: withContent.filter(({ p }) => p.data.kind === 'personal') },
  { id: 'university', title: 'University projects', items: withContent.filter(({ p }) => p.data.kind === 'university') },
];
const github = 'https://github.com/Nadavsim';
const linkedin = 'https://www.linkedin.com/in/Nadav-Simchai';
const email = 'ndvsim@gmail.com';
---
<Base>
  <header class="hero">
    <div class="wrap">
      <h1>
        Nadav<br />Simchai<span class="origin" aria-hidden="true">
          <svg class="rings" viewBox="0 0 800 800" fill="none" stroke="currentColor">
            <circle cx="400" cy="400" r="130" />
            <circle cx="400" cy="400" r="230" />
            <circle cx="400" cy="400" r="330" />
            <circle cx="400" cy="400" r="395" />
          </svg>
        </span>
      </h1>
      <p class="intro">
        I'm a computer science graduate from Ben-Gurion University, looking for a junior full-stack or software engineering role. These are the projects I'm proudest of.
      </p>
      <p class="contact">
        <a href={`mailto:${email}`}>{email}</a>
        <a href={linkedin}>LinkedIn</a>
        <a href={github}>GitHub</a>
      </p>
    </div>
  </header>

  <main>
    {groups.map((g) => (
      <section class="group" aria-labelledby={g.id}>
        <div class="wrap">
          <h2 id={g.id}>{g.title}</h2>
        </div>
        <ul class="rows">
          {g.items.map(({ p, Content }) => (
            <li class="row" data-shots={p.data.shots.length || undefined}>
              <div class="wrap row-grid">
                <h3>{p.data.repo ? <a href={p.data.repo} tabindex="-1" aria-hidden="true">{p.data.title}</a> : p.data.title}</h3>
                <div class="text">
                  <p class="summary">{p.data.summary}</p>
                  <div class="body"><Content /></div>
                  <ul class="tech">{p.data.tech.map((t) => <li>{t}</li>)}</ul>
                  <p class="links">
                    {p.data.repo && <a href={p.data.repo}>View the code</a>}
                    {p.data.demo && <a href={p.data.demo}>Try it live</a>}
                    {p.data.note && <span>{p.data.note}</span>}
                    {p.data.status === 'in-progress' && <span class="wip">Still in progress</span>}
                  </p>
                </div>
                <div class="fig">
                  <div class="viewport" style={p.data.shots.length ? `--ratio: ${p.data.shots[0].w} / ${p.data.shots[0].h}` : undefined}>
                    <div class="track">
                      <div class="panel"><Figure name={p.data.figure} /></div>
                      {p.data.shots.map((shot) => (
                        <a class="panel" href={shot.src} target="_blank" rel="noopener" inert>
                          <img class="shot" src={shot.src} alt={shot.alt} width={shot.w} height={shot.h} loading="lazy" />
                        </a>
                      ))}
                    </div>
                  </div>
                  {p.data.shots.length > 0 && (
                    <button class="flip" type="button" data-label={p.data.shotsLabel} data-title={p.data.title}>See {p.data.shotsLabel}</button>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>

  <footer>
    <div class="wrap">
      <p>Want to talk? Write to <a href={`mailto:${email}`}>{email}</a> or find me on <a href={linkedin}>LinkedIn</a>.</p>
    </div>
  </footer>
</Base>

<style>
  .wrap { max-width: 1280px; margin: 0 auto; padding-inline: var(--gutter); }

  .hero { position: relative; overflow: hidden; padding-block: clamp(56px, 12vw, 150px) clamp(48px, 9vw, 110px); }
  .hero .wrap { position: relative; }
  .origin { position: relative; display: inline-block; width: 0.16em; height: 0.16em; margin-left: 0.05em; border-radius: 50%; background: var(--signal); }
  .rings { position: absolute; left: 50%; top: 50%; width: min(150vw, 1100px); translate: -50% -50%; color: var(--soft); opacity: 0.35; pointer-events: none; }
  .rings circle { stroke-width: 2; }
  h1 {
    margin: 0;
    font-size: clamp(4.5rem, 19vw, 15rem);
    line-height: 0.82;
    font-weight: 800;
    letter-spacing: -0.04em;
    font-variation-settings: 'wdth' 75, 'opsz' 96;
  }
  .intro { max-width: 34ch; margin: clamp(28px, 5vw, 56px) 0 0; font-size: clamp(1.25rem, 2.4vw, 1.75rem); line-height: 1.3; font-weight: 500; font-variation-settings: 'opsz' 24; }
  .contact { display: flex; flex-wrap: wrap; gap: 0 28px; margin: 14px 0 0; font-weight: 600; }
  .contact a { padding-block: 10px; }

  .group { padding-top: clamp(32px, 6vw, 72px); }
  h2 { margin: 0 0 24px; font-size: clamp(1.75rem, 3.2vw, 2.5rem); line-height: 1.1; font-weight: 700; letter-spacing: -0.02em; font-variation-settings: 'wdth' 85, 'opsz' 48; }

  .rows { list-style: none; margin: 0; padding: 0; }
  .row { --row-bg: var(--blue); --row-text: var(--paper); background: var(--row-bg); border-top: 2px solid var(--paper); padding-block: clamp(28px, 4.5vw, 52px); transition: background-color 0.2s, color 0.2s; }
  .row:last-child { border-bottom: 2px solid var(--paper); }
  .row:focus-within { --row-bg: var(--signal); --row-text: var(--ink); color: var(--ink); }
  .row:focus-within .tech li { border-color: var(--ink); }
  .row:focus-within :is(a, .flip):focus-visible { outline-color: var(--ink); }
  @media (hover: hover) {
    .row:hover { --row-bg: var(--signal); --row-text: var(--ink); color: var(--ink); }
    .row:hover .tech li { border-color: var(--ink); }
  }

  .row-grid { display: grid; gap: 24px; grid-template-columns: 1fr; }
  h3 {
    margin: 0;
    font-size: clamp(2.1rem, 5.4vw, 4rem);
    line-height: 0.95;
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variation-settings: 'wdth' 82, 'opsz' 72;
    text-wrap: balance;
  }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-thickness: 4px; }
  .summary { margin: 0 0 12px; font-size: 1.25rem; line-height: 1.3; font-weight: 600; }
  .body { max-width: 62ch; text-wrap: pretty; }
  .body :global(p) { margin: 0 0 12px; }
  .tech { list-style: none; padding: 0; margin: 16px 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tech li { border: 2px solid var(--soft); border-radius: 999px; padding: 2px 12px; font-size: 0.9rem; font-weight: 500; transition: border-color 0.2s; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 0 28px; margin: 0; font-weight: 600; }
  .links a { padding-block: 10px; }
  .links .wip { opacity: 0.85; }
  .fig { width: min(260px, 70%); color: var(--soft); transition: color 0.2s; }
  .viewport { overflow: hidden; aspect-ratio: var(--ratio, 4 / 3); border-radius: 14px; }
  .track { display: flex; height: 100%; transform: translateX(calc(var(--i, 0) * -100%)); transition: transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .panel { flex: 0 0 100%; display: grid; place-items: center; min-width: 0; }
  a.panel { text-decoration: none; }
  a.panel:focus-visible { outline-offset: -4px; }
  .row[data-shots] { cursor: pointer; }
  .flip { margin: 6px 0 0; padding: 8px 0; background: none; border: 0; color: var(--row-text); font: inherit; font-weight: 600; text-align: left; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; cursor: pointer; }
  .flip:focus-visible { outline: 3px solid var(--signal); outline-offset: 3px; border-radius: 2px; }
  .row:focus-within .fig { color: var(--ink); }
  @media (hover: hover) { .row:hover .fig { color: var(--ink); } }
  .fig :global(svg) { display: block; width: 100%; height: auto; }
  .shot { display: block; width: 100%; height: 100%; object-fit: contain; border: 2px solid currentColor; border-radius: 14px; }

  @media (min-width: 760px) {
    .row-grid { grid-template-columns: 1fr 240px; }
    h3 { grid-column: 1 / -1; }
    .fig { width: 100%; align-self: start; }
  }
  @media (min-width: 1100px) {
    .row-grid { grid-template-columns: 4fr 5fr 3fr; gap: 40px; align-items: start; }
    h3 { grid-column: auto; }
  }

  footer { padding-block: 56px 72px; }
  footer p { margin: 0; font-size: 1.25rem; font-weight: 600; }

  @media (prefers-reduced-motion: reduce) { .track { transition: none; } }

  @media (prefers-reduced-motion: no-preference) {
    .rings circle { transform-origin: 400px 400px; animation: ping 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    .rings circle:nth-child(1) { animation-delay: 0.1s; }
    .rings circle:nth-child(2) { animation-delay: 0.22s; }
    .rings circle:nth-child(3) { animation-delay: 0.34s; }
    .rings circle:nth-child(4) { animation-delay: 0.46s; }
    .origin { animation: ping 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    @keyframes ping { from { transform: scale(0.15); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    .row:hover .fig :global(.sweep), .row:focus-within .fig :global(.sweep) { animation: sweep 1.8s linear infinite; }
    @keyframes sweep { from { translate: 0 0; } to { translate: 136px 0; } }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.row[data-shots]').forEach((row) => {
    const track = row.querySelector<HTMLElement>('.track')!;
    const panels = Array.from(track.children) as HTMLElement[];
    const flip = row.querySelector<HTMLButtonElement>('.flip')!;
    const { label, title } = flip.dataset;
    const last = panels.length - 1;
    let index = 0;

    const show = (next: number) => {
      index = next > last ? 0 : next;
      track.style.setProperty('--i', String(index));
      panels.forEach((panel, i) => panel.toggleAttribute('inert', i !== index));
      flip.textContent = index === 0 ? `See ${label}` : index < last ? `Next (${index} of ${last})` : 'Back to the drawing';
      flip.setAttribute('aria-label', `${flip.textContent}, ${title}`);
    };

    show(0);
    flip.addEventListener('click', () => show(index + 1));
    row.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a, button') || window.getSelection()?.toString()) return;
      show(index + 1);
    });
  });
</script>
