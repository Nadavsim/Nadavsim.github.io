---
interface Props { name: 'tlv' | 'coffee' | 'scanner' | 'cluster' | 'nlp' | 'notes' }
const { name } = Astro.props;

const openPorts = [2, 9, 13, 22, 27];
const ports = Array.from({ length: 4 }, (_, row) => Array.from({ length: 8 }, (_, col) => ({
  x: 20 + col * 17, y: 24 + row * 24, open: openPorts.includes(row * 8 + col),
}))).flat();
---
<svg class={`figure figure-${name}`} viewBox="0 0 160 120" fill="none" stroke="currentColor"
  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'tlv' && (<>
    <circle cx="48" cy="72" r="6" fill="currentColor" />
    <circle cx="48" cy="72" r="22" opacity=".6" />
    <circle cx="48" cy="72" r="40" opacity=".3" />
    <path d="M48 72 C 76 104, 104 62, 128 56" stroke-dasharray="4 7" />
    <path d="M128 14 a13 13 0 0 1 13 13 c0 11 -13 26 -13 26 s-13 -15 -13 -26 a13 13 0 0 1 13 -13z" />
    <circle cx="128" cy="27" r="4" fill="currentColor" />
  </>)}
  {name === 'coffee' && (<>
    <path d="M10 106 H152" opacity=".4" />
    <path d="M12 86 H42 V64 H72 V76 H102 V36 H132 V48 H150" />
    <circle cx="42" cy="64" r="4" fill="currentColor" />
    <circle cx="72" cy="76" r="4" fill="currentColor" />
    <circle cx="102" cy="36" r="4" fill="currentColor" />
    <circle cx="132" cy="48" r="4" fill="currentColor" />
  </>)}
  {name === 'scanner' && (<>
    {ports.map((p) => <circle cx={p.x} cy={p.y} r="4.5" fill={p.open ? 'currentColor' : 'none'} opacity={p.open ? 1 : 0.55} />)}
    <path class="sweep" d="M12 10 V112" />
  </>)}
  {name === 'cluster' && (<>
    <rect x="8" y="45" width="26" height="30" rx="4" />
    <rect x="126" y="45" width="26" height="30" rx="4" />
    <rect x="66" y="14" width="28" height="22" rx="4" />
    <rect x="66" y="49" width="28" height="22" rx="4" />
    <rect x="66" y="84" width="28" height="22" rx="4" />
    <path d="M34 60 L66 25 M34 60 H66 M34 60 L66 95 M94 25 L126 60 M94 60 H126 M94 95 L126 60" opacity=".7" />
  </>)}
  {name === 'nlp' && (<>
    <rect x="6" y="88" width="26" height="14" rx="3" />
    <rect x="38" y="88" width="34" height="14" rx="3" />
    <rect x="78" y="88" width="20" height="14" rx="3" />
    <rect x="104" y="88" width="30" height="14" rx="3" />
    <rect x="140" y="88" width="16" height="14" rx="3" />
    <path d="M55 88 Q 38 44 19 88" />
    <path d="M55 88 Q 72 54 88 88" />
    <path d="M119 88 Q 88 4 55 88" opacity=".7" />
    <path d="M119 88 Q 134 52 148 88" />
  </>)}
  {name === 'notes' && (<>
    <rect x="36" y="10" width="100" height="70" rx="5" style="fill: var(--row-bg)" opacity=".5" />
    <rect x="25" y="20" width="100" height="70" rx="5" style="fill: var(--row-bg)" opacity=".75" />
    <rect x="14" y="30" width="100" height="70" rx="5" style="fill: var(--row-bg)" />
    <path d="M28 52 H96 M28 65 H84 M28 78 H92" />
    <circle cx="136" cy="108" r="3" />
    <circle cx="124" cy="108" r="3" fill="currentColor" />
    <circle cx="112" cy="108" r="3" />
  </>)}
</svg>
