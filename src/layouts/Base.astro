---
import '@fontsource-variable/bricolage-grotesque/wdth.css';
const { title = 'Nadav Simchai', description = 'Projects by Nadav Simchai: bots, security tools, distributed systems, NLP and web apps.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2231E0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  :root {
    --blue: #2231e0;
    --paper: #f4f3ff;
    --soft: #c4c8ff;
    --signal: #ffe14d;
    --ink: #0e1245;
    --gutter: clamp(16px, 4vw, 48px);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { background: var(--blue); scrollbar-color: var(--soft) var(--blue); }
  body {
    margin: 0;
    background: var(--blue);
    color: var(--paper);
    font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.55;
    font-variation-settings: 'opsz' 14;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-underline-offset: 0.2em; text-decoration-thickness: 2px; }
  a:focus-visible { outline: 3px solid var(--signal); outline-offset: 3px; border-radius: 2px; }
  ::selection { background: var(--signal); color: var(--ink); }
</style>
